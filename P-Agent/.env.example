# ============================================================
# P-Agent 환경설정 예시 파일
# ------------------------------------------------------------
# 이 파일을 복사해서 `.env` 로 만든 뒤 값을 채우세요.
#   (first_time_setup.bat 실행 시 자동으로 .env 가 생성됩니다)
# ⚠️ .env 파일은 절대 외부로 공유하지 마세요 (비밀 키 포함).
# ⚠️ 모든 경로는 프로젝트 폴더 기준 상대경로만 사용합니다.
# ============================================================

# ------------------------------------------------------------
# [1] LLM Provider 선택
#   pgpt      = 배포용 (사내 P-GPT, OpenAI 호환 형식 가정)
#   anthropic = 개발용 (Claude API)
#   openai    = 개발용 (GPT-4o 등)
# ------------------------------------------------------------
LLM_PROVIDER=anthropic

# --- (배포용) 사내 P-GPT ---
PGPT_BASE_URL=https://your-internal-pgpt/v1
PGPT_API_KEY=
PGPT_MODEL=pgpt-default

# --- (개발용) Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- (개발용) OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------
# [2] 서버 포트 / 호스트
# ------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8756
FRONTEND_PORT=5173

# ------------------------------------------------------------
# [3] RAG / 임베딩 (로컬)
#   경로는 프로젝트 폴더 기준 상대경로
# ------------------------------------------------------------
EMBEDDING_MODEL_PATH=./models/bge-m3
CHROMA_DB_DIR=./data/chroma
RAG_TOP_K=5

# ------------------------------------------------------------
# [4] Vision / OCR (로컬)
# ------------------------------------------------------------
OMNIPARSER_MODEL_PATH=./models/omniparser
OCR_LANG=korean

# ------------------------------------------------------------
# [5] 웹 검색 (선택 기능 - 폐쇄망에서는 비활성/실패 허용)
# ------------------------------------------------------------
WEB_SEARCH_ENABLED=false
WEB_SEARCH_API_KEY=

# ------------------------------------------------------------
# [6] 안전장치
# ------------------------------------------------------------
KILL_SWITCH_KEY=esc
REQUIRE_APPROVAL=true
ACTION_LOG_PATH=./logs/actions.jsonl

# ------------------------------------------------------------
# [7] 출력물 / 로그 경로 (모두 프로젝트 폴더 내부)
# ------------------------------------------------------------
OUTPUT_DIR=./output
LOG_DIR=./logs
DATA_DIR=./data

# ------------------------------------------------------------
# [8] 실행 모드
#   development = 개발 (상세 로그)
#   production  = 배포 (최소 로그)
# ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
