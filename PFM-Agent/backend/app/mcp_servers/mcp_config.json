{
  "_comment": [
    "PFM-Agent 내부 MCP 서버 등록 정보.",
    "새 도구 서버를 추가하려면 이 파일에 항목을 추가하기만 하면 됩니다.",
    "자세한 방법은 MCP_GUIDE_KR.md 를 참고하세요.",
    "",
    "command 가 'python' 이면 현재 가상환경(.venv)의 파이썬으로 자동 치환됩니다.",
    "(시스템 PATH 에 의존하지 않기 위한 포터블 처리)",
    "",
    "require_approval: true 인 서버의 도구는 실행 전 사용자 승인이 필요합니다."
  ],
  "servers": {
    "filesystem": {
      "command": "python",
      "args": [
        "-m",
        "app.mcp_servers.filesystem_server"
      ],
      "enabled": true,
      "require_approval": false,
      "description": "파일 읽기/쓰기/목록"
    },
    "screen": {
      "command": "python",
      "args": [
        "-m",
        "app.mcp_servers.screen_server"
      ],
      "enabled": true,
      "require_approval": false,
      "description": "화면 캡처/UI 요소 탐지/OCR"
    },
    "automation": {
      "command": "python",
      "args": [
        "-m",
        "app.mcp_servers.automation_server"
      ],
      "enabled": true,
      "require_approval": true,
      "description": "마우스/키보드/브라우저 조작 (위험 - 승인 필요)"
    },
    "rag": {
      "command": "python",
      "args": [
        "-m",
        "app.mcp_servers.rag_server"
      ],
      "enabled": true,
      "require_approval": false,
      "description": "사내 문서 검색"
    },
    "report": {
      "command": "python",
      "args": [
        "-m",
        "app.mcp_servers.report_server"
      ],
      "enabled": true,
      "require_approval": false,
      "description": "Word/PPT 보고서 생성"
    },
    "team": {
      "command": "python",
      "args": [
        "-m",
        "app.mcp_servers.team_server"
      ],
      "enabled": true,
      "require_approval": false,
      "description": "팀 대화방 공유 (목록/글쓰기/파일공유/회의록 저장)"
    }
  }
}
