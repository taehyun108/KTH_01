{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PFM-Agent",
  "version": "0.1.0",
  "identifier": "com.poscofuturem.pfmagent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "PFM-Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8756 ws://127.0.0.1:8756; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "id": "pfm-agent-tray",
      "iconPath": "icons/icon.png",
      "tooltip": "PFM-Agent"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png"],
    "resources": [],
    "copyright": "POSCO FUTURE M",
    "shortDescription": "GUI 기반 AI Agent",
    "longDescription": "자연어 명령으로 PC 를 조작하고 보고서를 자동 생성하는 사내 AI Agent"
  }
}
