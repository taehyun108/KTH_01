# ─────────────────────────────────────────────────────────────
# TripVerify 환경변수 예시 (§5)
# 이 파일을 .env.local 로 복사해서 채운다. .env* 는 커밋되지 않는다.
#
# 핵심 원칙: 키가 하나도 없어도 앱은 폴백 소스로 완전 동작한다.
#   - 날씨   : Open-Meteo (키 불필요)
#   - 장소   : OpenStreetMap / Overpass (키 불필요)
#   - 동선   : OSRM public demo (키 불필요)
#   - 환율   : exchangerate.host / ECB (키 불필요)
#   - 최신정보: Firecrawl(있으면) → WebSearch 폴백
# 키가 주어지면 정확도/한도가 높은 소스로 자동 업그레이드된다.
# ─────────────────────────────────────────────────────────────

# --- DB ---
# 개발: SQLite 파일 경로. 운영: postgres:// 연결 문자열
DATABASE_URL=./tripverify.dev.sqlite

# --- AI (서브에이전트 병렬 호출) ---
ANTHROPIC_API_KEY=

# --- 환율 (선택: 없으면 exchangerate.host/ECB 폴백) ---
KOREAEXIM_API_KEY=

# --- 장소·좌표 (선택: 없으면 OSM/Overpass 폴백) ---
GOOGLE_MAPS_API_KEY=
FOURSQUARE_API_KEY=

# --- 동선 (선택: 없으면 OSRM 폴백) ---
# GOOGLE_MAPS_API_KEY 를 Directions 에 공용으로 사용

# --- 항공 (선택: 없으면 항공사 공식 스케줄/스크래핑 폴백) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- 날씨 (선택: 기본은 Open-Meteo 키불필요) ---
OPENWEATHERMAP_API_KEY=

# --- 최신정보 스크래핑 (선택) ---
FIRECRAWL_API_KEY=
